{
  "schemaVersion": 1,
  "id": "spearfix-addon",
  "version": "${version}",
  "name": "Meteor SpearFix Addon",
  "description": "为 Meteor 添加 SpearFix 支持",
  "authors": [
    "kono_yalu"
  ],
  "contact": {
    "sources": "https://github.com/benjamin920101/Meteor-spearfix-plugin"
  },
  "icon": "assets/spearfix/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.spearfix.addon.SpearFixAddon"
    ]
  },
  "mixins": [
    "spearfix.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25"
  },
  "depends": {
    "java": ">=21",
    "minecraft": ">=1.21 <=1.21.9",
    "meteor-client": "*"
  }
}
